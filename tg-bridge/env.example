# Telegram job-search bridge secrets — NEVER commit real values here.
# Copy this file to state/.env and fill in the real values.

# From @BotFather when creating the bot:
TG_BOT_TOKEN=

# NAN API key (OpenAI-compatible endpoint):
NAN_API_KEY=

# Optional overrides (sensible defaults exist):
# NAN_BASE_URL=https://api.nan.builders/v1
# NAN_MODEL=qwen3.8-flash
# NAN_EVAL_MODEL=deepseek-v4-flash
# FIT_THRESHOLD=75

# Lock the bot to one chat (registered chat_id after the first /start):
# CHAT_ID=

# Personalisation (all optional; set real values only in state/.env):
# Name the assistant uses for the candidate (default: "la candidata").
# CANDIDATE_NAME=
# Full name used to sign application email drafts (default: CANDIDATE_NAME).
# CANDIDATE_FULL_NAME=
# Contact line (phone/email) appended under the signature in drafts (default: none).
# CANDIDATE_CONTACT=
# Comma-separated first names of real people the bot must never redirect the
# candidate to; sentences naming them are stripped. Generic patterns such as
# "tu hijo" always apply. Default: empty.
# OPERATOR_NAMES=
# File inside state/ that stores the registered chat id (default: chat.json).
# CHAT_REGISTRY_FILE=chat.json
